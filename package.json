{
  "name": "snake-game",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": "^22.12.0 || >=24.0.0 <25"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2",
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local scripts/dev-server.mjs",
    "dev:client": "vite",
    "dev:full": "node --env-file-if-exists=.env.local scripts/dev-server.mjs",
    "build": "tsc -b && vite build",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:local": "node --env-file-if-exists=.env.local scripts/smoke-local.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@neon/config": "^1.9.2",
    "@neon/env": "^1.6.4",
    "@neondatabase/serverless": "^1.2.0",
    "@tailwindcss/vite": "^4.1.14",
    "argon2": "^0.45.1",
    "jose": "^6.2.13",
    "lucide-react": "^0.545.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.3",
    "tailwindcss": "^4.1.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.7.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "jsdom": "^27.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vercel": "^64.5.0",
    "vite": "^7.1.7",
    "vitest": "^5.0.5"
  }
}
