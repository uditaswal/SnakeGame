# Neon pooled Postgres connection string. Server-only: never expose this through
# a VITE_ variable or import it into browser code.
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/snake_game?sslmode=require
# Optional direct URL for migrations. Vercel's Neon integration provides it.
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-example.region.aws.neon.tech/snake_game?sslmode=require

# Exact public origin. Do not include a trailing slash.
APP_ORIGIN=http://localhost:3001

# Public canonical origin used in page metadata and social cards. This value is
# included in the browser bundle and must never contain a secret.
VITE_SITE_ORIGIN=http://localhost:3001

# At least 32 random bytes, encoded as hex or base64. Used only to pseudonymize
# rate-limit identifiers; it is not stored in the browser.
RATE_LIMIT_SECRET=replace-with-a-long-random-secret

